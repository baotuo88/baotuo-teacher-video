# Copy to .env next to docker-compose.yml and edit.

# Which image to run. Pin a version (…:1.0.0) to update only when you choose to.
IMAGE=ghcr.io/baotuo88/baotuo-teacher-video:latest
# Mainland China: if pulling from ghcr.io is slow, use the Alibaba Cloud mirror when the repo publishes one, e.g.
# IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/baotuo-teacher-video:latest

PORT=8000
# Strongly recommended when the port is reachable from other machines
APP_PASSWORD=

# Model credentials (optional here: you can also fill them in on the Settings page)
# LLM_PROVIDER: anthropic | openai  (openai = any OpenAI-compatible API: DeepSeek, Qwen, Kimi, GLM, OpenRouter …)
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# anthropic only: x-api-key (official) or bearer (most relay services)
LLM_AUTH=x-api-key
# TTS key for an OpenAI-compatible speech API (e.g. SiliconFlow); Edge read-aloud needs none
TTS_API_KEY=
