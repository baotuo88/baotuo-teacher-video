# Copy to .env and edit. docker compose reads it automatically.

PORT=8000
# Strongly recommended when the port is reachable from other machines
APP_PASSWORD=

# Model credentials (optional here: you can also fill them in on the Settings page)
# LLM_PROVIDER: anthropic | openai  (openai = any OpenAI-compatible API: DeepSeek, Qwen, Kimi, GLM, OpenRouter …)
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# anthropic only: x-api-key (official) or bearer (most relay services)
LLM_AUTH=x-api-key
# TTS key for an OpenAI-compatible speech API (e.g. SiliconFlow); Edge read-aloud needs none
TTS_API_KEY=

# ── Building in mainland China: uncomment these mirrors ──
# BASE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
# APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# If GitHub is slow, fetch the engine on the host first (scripts/fetch-engine.sh vendor), or point to a mirror:
# FRAMETELL_REPO=https://gitee.com/<mirror>/frametell.git
